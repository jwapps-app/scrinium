# Copy to .env for local dev. Production values live in Portainer, never here.
ENVIRONMENT=development
APP_NAME=Scrinium
# Dev compose maps container 5432 -> host 5434 (5432/5433 belong to other stacks)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5434/app
SECRET_KEY=dev-secret-change-me
ALLOWED_ORIGINS=http://localhost:5173
DATA_DIR=./data

OCR_ENGINE=tesseract
OCR_LANGUAGES=eng
# Mac sidecar (build-order step 4+):
# APPLE_OCR_URL=http://host.docker.internal:9876
